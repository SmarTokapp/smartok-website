{
  "hosting": {
    "public": ".",
    "redirects": [
      {
        "source": "/about-us",
        "destination": "/#about",
        "type": 301
      },
      {
        "source": "/about-us/",
        "destination": "/#about",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
